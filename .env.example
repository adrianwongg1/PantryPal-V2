# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---------------------------------------------------------
# Project Settings > API. Prefer the new publishable key over the legacy
# anon JWT where your project has one (older projects may only have the
# legacy key, which still works fine — src/lib/env.ts doesn't check format).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for one-off admin scripts (e.g. scripts/migrate-mongo.ts), NOT
# by the running app — leave unset unless you're running one of those.
# service_role / bypasses RLS. Get it from Project Settings > API.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AI -----------------------------------------------------------------
# Groq: free tier, default model for recipe generation + transcription.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic: fallback tier when Groq rate-limits or returns invalid JSON.
# Optional — leave unset and generation just runs Groq-only (one retry on
# a schema-invalid response, no third attempt). Get a key at
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides — sensible defaults are baked into src/lib/env.server.ts
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# ANTHROPIC_TEXT_MODEL=claude-haiku-4-5

# --- App ------------------------------------------------------------------
# Used to build absolute URLs for Open Graph images and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
